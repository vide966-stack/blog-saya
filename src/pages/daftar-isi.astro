---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const daftarIsiPost = await getEntry("spec", "daftar-isi");

if (!daftarIsiPost) {
    throw new Error("Daftar Isi page content not found");
}

const { Content } = await render(daftarIsiPost);
---
<MainGridLayout title="Daftar Isi" description="Daftar Isi TEKB: Mencari Bukti di Balik Sinyal Trading">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>